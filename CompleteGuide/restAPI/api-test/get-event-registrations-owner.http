@baseUrl = http://localhost:8080

###
# Paste token here (WITHOUT quotes) - must be OWNER token
@token = paste_owner_token_here

###
# Event Id (must be owned by the token user)
@eventId = 1

###
# Get registrations for an event (Owner only)
GET {{baseUrl}}/events/{{eventId}}/registrations
Authorization: Bearer {{token}}
