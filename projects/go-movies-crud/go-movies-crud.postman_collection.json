{
  "info": {
    "_postman_id": "8c3c0ad0-9ec3-4f6c-931e-2f16db2f0904",
    "name": "Go Movies CRUD API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get All Movies",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is an array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Movie By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Movie contains an id\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property(\"id\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Movie",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isbn\": \"9780140177398\",\n  \"title\": \"The New Movie\",\n  \"director\": {\n    \"firstName\": \"Ada\",\n    \"lastName\": \"Lovelace\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.collectionVariables.set(\"movieId\", jsonData.id);",
              "",
              "pm.test(\"Created movie id was saved\", function () {",
              "    pm.expect(jsonData.id).to.exist;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Movie",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isbn\": \"9780140177398\",\n  \"title\": \"The Updated Movie\",\n  \"director\": {\n    \"firstName\": \"Grace\",\n    \"lastName\": \"Hopper\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Movie title was updated\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql(\"The Updated Movie\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Movie",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/movies/{{movieId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "movies",
            "{{movieId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "movieId",
      "value": "1"
    }
  ]
}
